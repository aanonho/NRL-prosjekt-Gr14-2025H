<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <!-- Correct relative path:
             WebApplication1.Tests/WebApplication1.Tests.csproj
             -> .. (NRL-prosjekt-Gr14-2025H)
             -> WebApplication1/WebApplication1.csproj -->
        <ProjectReference Include="..\WebApplication1/WebApplication1.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- ASP.NET Core shared framework -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <!-- Test SDK + xUnit only -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
        <PackageReference Include="xunit" Version="2.8.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- EF Core InMemory – match your main project EF version -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.9" />
    </ItemGroup>

</Project>
