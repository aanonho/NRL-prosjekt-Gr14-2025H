@model WebApplication1.Models.ReportItem
@using WebApplication1.Models

@{
    ViewData["Title"] = "Report Details";
    var user = ViewBag.CurrentUser as UserData;
    bool isRegistrar = user?.Role == "Registrar";
    bool isDraft = Model.IsDraft;
}
<!-- Leaflet CSS -->
<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />

<!-- Custom page CSS -->
<link rel="stylesheet" href="~/css/shared.css" />

<div class="flex min-h-screen flex-col items-center bg-gray-50 px-4 py-10 sm:px-6 lg:px-8">
    <div class="form-container">
        <h1 class="mb-8 text-center text-3xl font-bold text-blue-700">
            Obstacle Details
        </h1>

        <!-- Readonly Map -->
        <div class="mx-auto mb-8 w-full max-w-4xl">
            <div id="detailsMap" style="width:100%; height:350px; border-radius: 10px;"></div>
        </div>

        <!-- Unified Form -->
        <form asp-action="SubmitDraft" asp-controller="Obstacle" method="post" class="space-y-6">
            <input type="hidden" name="Id" value="@Model.ReportID" />

            <!-- Title -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Obstacle Type</label>
                @if (isDraft && !isRegistrar)
                {
                    <input type="text" name="ObstacleName" value="@Model.ReportObstacle?.ObstacleName"
                           class="input-box w-full rounded border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-blue-500" />
                }
                else
                {
                    <p class="input-box rounded border border-gray-200 bg-gray-50 p-2 text-gray-800">@Model.ReportObstacle?.ObstacleName</p>
                }
            </div>

            <!-- Height -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Height (m)</label>
                @if (isDraft && !isRegistrar)
                {
                    <input type="number" step="0.1" name="ObstacleHeight" value="@Model.ReportObstacle?.ObstacleHeight"
                           class="input-box w-full rounded border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-blue-500" />
                }
                else
                {
                    <p class="input-box rounded border border-gray-200 bg-gray-50 p-2 text-gray-800">@Model.ReportObstacle?.ObstacleHeight</p>
                }
            </div>

            <!-- Description -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Description</label>
                @if (isDraft && !isRegistrar)
                {
                    <textarea name="ObstacleDescription" rows="3"
                          class="input-box w-full rounded border border-gray-700 p-2 shadow-sm focus:border-blue-500 focus:ring-blue-500">@Model.ReportObstacle?.ObstacleDescription</textarea>
                }
                else
                {
                    <p class="input-box rounded border border-gray-700 bg-gray-50 p-2 text-gray-800">@Model.ReportObstacle?.ObstacleDescription</p>
                }
            </div>

            <!-- Organization -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Organization</label>
                <p class="input-box rounded border border-gray-700 bg-gray-50 p-2 text-gray-800">@Model.Organization</p>
            </div>

            <!-- Status -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Status</label>
                <p class="input-box rounded border border-gray-700 bg-gray-50 p-2 text-gray-800">@Model.Status</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ReviewMessage))
            {
                <div>
                    <label class="block text-sm font-medium text-gray-700">Registrar Comment</label>
                    <p class="mt-1 rounded border border-gray-300 bg-gray-50 p-2 text-sm text-gray-800">
                        @Model.ReviewMessage
                    </p>
                </div>
            }


            <!-- Attached Image Section -->
            @if (Model.ReportObstacle != null && !string.IsNullOrWhiteSpace(Model.ReportObstacle.ImagePath))
            {
                <div class="mt-6">
                    <h3 class="mb-3 text-center text-lg font-semibold text-gray-700 sm:text-left">
                        Attached Image
                    </h3>

                    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
                        <a href="@Model.ReportObstacle.ImagePath" target="_blank" class="block max-w-full sm:w-auto">
                            <img src="@Model.ReportObstacle.ImagePath"
                                 alt="Obstacle image"
                                 class="w-full max-w-sm rounded-lg border border-gray-300 object-contain shadow-md transition hover:shadow-lg sm:max-w-md" />
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="mt-6 text-center text-gray-500 sm:text-left">
                    <em>No image attached for this report.</em>
                </div>
            }



            <!-- Registrar Approval Section -->
            @if (isRegistrar && !isDraft)
            {
                <div class="mt-8 border-t border-gray-500 pt-6">
                    <label class="mb-2 block text-sm font-medium text-gray-800">
                        Registrar Comment (optional)
                    </label>
                    <textarea name="message"
                          rows="3"
                          class="w-full rounded-md border border-gray-500 p-2 text-sm shadow-sm focus:border-blue-500 focus:ring-blue-500"
                          placeholder="Write your feedback for the user here...">@Model.ReviewMessage</textarea>

                    <div class="mt-4 flex flex-col justify-center gap-3 sm:flex-row">
                        <button type="submit"
                                name="status"
                                value="Approved"
                                formaction="@Url.Action("UpdateReportStatus", "User")"
                                class="w-full rounded-md border border-green-600 bg-green-100 px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-green-200 focus:ring-2 focus:ring-green-400 focus:ring-offset-2 sm:w-auto">
                            Approve
                        </button>

                        <button type="submit"
                                name="status"
                                value="Rejected"
                                formaction="@Url.Action("UpdateReportStatus", "User")"
                                class="w-full rounded-md border border-red-600 bg-red-100 px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-red-200 focus:ring-2 focus:ring-red-400 focus:ring-offset-2 sm:w-auto">
                            Reject
                        </button>
                    </div>
                </div>
            }






            <!-- Draft Save/Submit -->
            @if (isDraft && !isRegistrar)
            {
                <div class="button-group center-button mt-6">
                    <button type="submit" name="actionType" value="SaveDraft" class="button-white-blue">
                        Save Draft
                    </button>
                    <button type="submit" name="actionType" value="Submit" class="button-dark-green">
                        Submit Report
                    </button>
                </div>
            }
        </form>

        <!-- Back Button -->
        <div class="mt-8 text-center">
            <a href="@(ViewBag.ReturnUrl ?? Url.Action("UserProfile", "User", new { email = (ViewBag.CurrentUser as WebApplication1.Models.UserData)?.Email }))"
               class="inline-block rounded-lg bg-gray-800 px-6 py-2 font-semibold text-gray-700 transition hover:bg-gray-900">
                Back
            </a>
        </div>
    </div>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const mapDiv = document.getElementById("detailsMap");
            if (!mapDiv) return;

            const obstacle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReportObstacle));

            // Init map in center of Norway fallback
            const map = L.map("detailsMap").setView([64.5, 11.0], 5);

            // Tile layer
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19
            }).addTo(map);

            if (!obstacle) return;

            // POINT / AREA
            if (obstacle.obstacleLatitude && obstacle.obstacleLongitude) {
                const lat = obstacle.obstacleLatitude;
                const lng = obstacle.obstacleLongitude;

                // Area (circle)
                if (obstacle.obstacleType === "area") {
                    const radius = obstacle.obstacleRadius || 300;
                    L.circle([lat, lng], {
                        radius: radius,
                        color: "red",
                        fillColor: "#f03",
                        fillOpacity: 0.5
                    }).addTo(map);

                    map.setView([lat, lng], 15);
                }

                // Point
                else if (obstacle.obstacleType === "point") {
                    L.marker([lat, lng]).addTo(map);
                    map.setView([lat, lng], 16);
                }
            }

            // LINE
            if (obstacle.obstacleType === "line" && obstacle.obstacleLineCoordinates) {

                const coords = obstacle.obstacleGeoJson
                    ? JSON.parse(obstacle.obstacleGeoJson).geometry.coordinates
                    : [];

                if (coords.length >= 2) {
                    const latlngs = coords.map(c => [c[1], c[0]]);
                    const line = L.polyline(latlngs, { color: "black", weight: 3 }).addTo(map);
                    map.fitBounds(line.getBounds());
                }
            }

        });
    </script>
</div>
