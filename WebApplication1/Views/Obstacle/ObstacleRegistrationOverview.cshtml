@using WebApplication1.Models.Entities
<!-- Displays submitted obstacle data and map markers based on location. -->
@model ObstacleData

<!-- Custom page CSS -->
<link rel="stylesheet" href="~/css/shared.css" />
<link rel="stylesheet" href="~/css/obstacleForm.css" />

<div class="container mx-auto mt-6 px-4">
    <div class="overflow-hidden rounded-lg bg-white shadow-md">
        <!-- Header -->
        <div class="bg-green-500 px-4 py-3 text-white">
            <h2 class="text-xl font-bold sm:text-2xl">@(Model.IsDraft ? "Draft saved" : "Report submitted")</h2>
        </div>

        <!-- Body -->
        <div class="p-4">
            <p class="mb-4 text-gray-700">@(Model.IsDraft ? "You have saved a draft. You may edit and submit later." : "Thank you for registering an obstacle. Here are the details:")</p>

            <dl class="grid grid-cols-1 gap-4 text-gray-800 sm:grid-cols-2">
                <div>
                    <dt class="font-medium">Name</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.ObstacleName) ? "Not provided" : Model.ObstacleName)</dd>
                </div>

                <div>
                    <dt class="font-medium">Height</dt>
                    <dd>@(Model.ObstacleHeight == null || Model.ObstacleHeight <= 0 ? "Not provided" : $"{Model.ObstacleHeight} m")</dd>
                </div>

                <div>
                    <dt class="font-medium">Description</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.ObstacleDescription) ? "Not provided" : Model.ObstacleDescription)</dd>
                </div>

                <!-- Image preview (only show if an image exists) -->
                <div class="mt-4">
                    <dt class="font-medium">Uploaded Image</dt>
                    <dd>
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <img src="@Model.ImagePath" alt="Obstacle Image" width="200" height="200" />
                        }
                        else
                        {
                            <p class="text-gray-500">No image uploaded.</p>
                        }
                    </dd>
                </div>

                <div>
                    <dt class="font-medium">Latitude</dt>
                    <dd>@Model.ObstacleLatitude</dd>
                </div>

                <div>
                    <dt class="font-medium">Longitude</dt>
                    <dd>@Model.ObstacleLongitude</dd>
                </div>

                <div>
                    <dt class="font-medium">Submitted</dt>
                   <dd>@Model.ObstacleRegistrationLocalTime.ToString("dd.MM.yyyy HH:mm:ss")</dd>
                </div>
            </dl>

            <!-- Map -->
            <div id="map" class="mt-6 h-96 w-full rounded border-2 border-gray-300 sm:h-80"></div>

            <!-- Button -->
            <div class="mt-6">
                <a asp-action="DataForm" class="inline-block rounded bg-blue-500 px-4 py-2 text-white hover:bg-blue-600">
                    Register another obstacle
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var lat = @(Model.ObstacleLatitude.HasValue? Model.ObstacleLatitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "0");
        var lng = @(Model.ObstacleLongitude.HasValue? Model.ObstacleLongitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "0");

        var map = L.map('map').setView([lat, lng], 14);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        // HelicopterIcon
        var helicopterIcon = L.icon({
        iconUrl: '/icons/helicopter.svg',
        iconSize: [60, 60],
        iconAnchor: [30, 30]
         });

        L.marker([lat, lng], {icon: helicopterIcon})
            .addTo(map)
            .bindPopup("<b>@Model.ObstacleName</b><br/>Height: @Model.ObstacleHeight m")
            .openPopup();
    });
</script>
