<!-- Skjema for hinderregistrering med Leaflet-kart.
     Lat/Lng fra kartklikk eller nettleserens geolokasjon (auto-sentrering ved tillatelse). -->
@model WebApplication1.Models.ObstacleData

@{
    ViewData["Title"] = "Obstacle Registration";
}

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<div style="display:flex; gap:20px; margin-top:20px; flex-wrap: wrap;">
    <!-- Form left -->
    <div style="flex:1 1 300px; background:white; padding:20px; border-radius:8px;">
        <h1 class="text-2xl sm:text-3xl font-bold mb-6 text-center">Obstacle Registration Form</h1>

        <!-- choose an obstacle type -->
        <div class="mb-4 sm:col-span-2">
            <label asp-for="ObstacleType" class="block mb-1 font-medium text-gray-700">Choose Obstacle:</label>
            <select asp-for="ObstacleType" class="w-full border border-gray-300 rounded p-2">
                <option value="" selected disabled>-Select Obstacle-</option>
                <option value="point">Point</option>
                <option value="mast">Mast</option>
                <option value="cable">Cable</option>
                <option value="line">Line</option>
                <option value="area">Area</option>
            </select>
            <span asp-validation-for="ObstacleType" class="text-red-500"></span> 
        </div>

        <!-- Area radius input, shown only if "area" is selected -->
        <div class="mb-4 sm:col-span-2" id="areaRadiusContainer" style="display:none;">
            <label asp-for="ObstacleRadius" class="block mb-1 font-medium text-gray-700"> Area Radius (optional, default 300 meters) </label>          
            <input asp-for="ObstacleRadius" type="number" step="any" class="w-full border border-gray-300 rounded p-2" placeholder="300" />
            <span asp-validation-for="ObstacleRadius" class="text-red-500"></span>
        </div>      

        <!-- Line/Cable length input-->
        <div class="mb-4 sm:col-span-2" id="lineLengthContainer" style="display:none;">
            <label asp-for="ObstacleLineLength" class="block mb-1 font-medium text-gray-700">Line/Cable Length (meters)</label>
            <input asp-for="ObstacleLineLength" type="number" step="any" class="w-full border border-gray-300 rounded p-2" placeholder="e.g., 2.5" />
            <span asp-validation-for="ObstacleLineLength" class="text-red-500"></span>
        </div>

        <!-- Form -->
        <form asp-controller="Obstacle" asp-action="DataForm" method="post" enctype="multipart/form-data" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="submitType" id="submitType" value="Submit" />

            <!-- Hidden fields for geometry -->
            <input asp-for="ObstacleGeometry" id="ObstacleGeometry" type="hidden" />
            <input asp-for="ObstacleRadius" id="ObstacleRadiusHidden" type="hidden" />
            <input asp-for="ObstacleType" id="ObstacleTypeHidden" type="hidden" />
            

            <div asp-validation-summary="All" class="text-red-500 mb-4 sm:col-span-2"></div>

            <div>
                <label asp-for="ObstacleName" class="block mb-1 font-medium text-gray-700">Obstacle Name</label>
                <input asp-for="ObstacleName" class="w-full border border-gray-300 rounded p-2" placeholder="e.g., Wall, Ramp"/>
                <span asp-validation-for="ObstacleName" class="text-red-500"></span>
            </div>

            <div>
                <label asp-for="ObstacleHeight" class="block mb-1 font-medium text-gray-700">Obstacle Height (meters)</label>
                <input asp-for="ObstacleHeight" type="number" step="any" class="w-full border border-gray-300 rounded p-2" placeholder="e.g., 2.5"/>
                <span asp-validation-for="ObstacleHeight" class="text-red-500"></span>
            </div>

            <div class="sm:col-span-2">
                <label asp-for="ObstacleDescription" class="block mb-1 font-medium text-gray-700">Obstacle Description</label>
                <textarea asp-for="ObstacleDescription" class="w-full border border-gray-300 rounded p-2 h-96" placeholder="Describe the obstacle, meterials, location, etc."></textarea>
                <span asp-validation-for="ObstacleDescription" class="text-red-500"></span>
            </div>

            <!-- Image upload -->
            <div class="sm:col-span-2">
                <label for="ObstacleImage" class="block mb-1 font-medium text-gray-700">Upload Image</label>
                <input type="file" name="imageFile" id="ObstacleImage" class="w-full border border-gray-300 rounded p-2" />

                <!-- Image preview + delete -->
                <div id="imageContainer" class="mt-2 hidden">
                    <img id="imagePreview" class="max-h-60 rounded border border-gray-300" />
                    <button type="button" id="removeImageButton"
                            class="block mt-2 bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded">
                            Remove Image
                    </button>
                </div>
            </div>


            <script>
              
                const fileInput = document.getElementById('ObstacleImage');
                const imagePreview = document.getElementById('imagePreview');
                const imageContainer = document.getElementById('imageContainer');
                const removeButton = document.getElementById('removeImageButton');
              
                // When user uploads an image
                fileInput.addEventListener('change', function(event) {
                    const file = event.target.files[0];
                    if (!file) return;

                    const reader = new FileReader();
                    reader.onload = function() {
                        imagePreview.src = reader.result;
                        imageContainer.classList.remove('hidden');
                    };
                    reader.readAsDataURL(file);
                });

                // When user clicks remove button
                removeButton.addEventListener('click', function() {
                    fileInput.value = ""; // removes file input
                    imagePreview.src = "";
                    imageContainer.classList.add('hidden');
                });
            </script>

            <div>
                <label asp-for="ObstacleLatitude" class="block mb-1 font-medium text-gray-700">Latitude</label>            
                <input asp-for="ObstacleLatitude" id="ObstacleLatitude" type="number" step="any" class="w-full border border-gray-300 rounded p-2" placeholder="Auto-filled (point, mast, area)" readonly />
            </div>

            <div>
                <label asp-for="ObstacleLongitude" class="block mb-1 font-medium text-gray-700">Longitude</label>             
                <input asp-for="ObstacleLongitude" id="ObstacleLongitude" type="number" step="any" class="w-full border border-gray-300 rounded p-2" placeholder="Auto-filled (point, mast, area)" readonly />
            </div>

            <div class="sm:col-span-2 flex gap-6 mt-4">
                <button type="submit" onclick="setSubmitType('Submit')" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded mt-4">
                    Submit Data
                </button>
                <button type="submit" onclick="setSubmitType('SaveDraft'); return true;" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded mt-4">
                    Save Draft
                </button>
            </div>
        </form>
    </div>

    <!-- Map right side -->
    <div style="flex:2 1 300px;">
        <div id="map" style="width:100%; height:900px; border:2px solid gray; border-radius:8px;"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" 
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var map = L.map('map').setView([58.1467, 7.9956], 12);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        var obstacleMarker;
        var circle;
        var line;
        var latlngsLine = [];
        var helicopterMarker;

        // Mast icon
        var mastIcon = L.icon({
            iconUrl: '/images/mast.svg',
            iconSize: [32, 64],
            iconAnchor: [16, 64]
            });

            // Show/hide relevant input fields based on selected obstacle type
        const obstacleTypeSelect= document.getElementById('ObstacleType');
        const obstacleTypeHidden = document.getElementById('ObstacleTypeHidden')
        const areaRadiusContainer= document.getElementById('areaRadiusContainer');   
        const lineLengthContainer= document.getElementById('lineLengthContainer');

            
        obstacleTypeSelect.addEventListener('change', function() {
            // Show radius input for area type
            if(obstacleTypeSelect.value ==='area') {
                areaRadiusContainer.style.display ='block';
            } else {
                areaRadiusContainer.style.display ='none';               
            }

            // Show height and length inputs for line/cable types
            if(obstacleTypeSelect.value ==='line' || obstacleTypeSelect.value ==='cable') {           
                lineLengthContainer.style.display ='block';
            } else {             
                lineLengthContainer.style.display ='none';
                }
        });

        // Handle map clicks to draw obstacle geometries (point, mast, area, line, cable))
        map.on('click', function(e) {         
            const type = document.getElementById('ObstacleType').value;

            // Clear previous drawings and reset fields
            document.getElementById('ObstacleLatitude').value = '';
            document.getElementById('ObstacleLongitude').value = '';
            
            if(obstacleMarker) 
            {
                map.removeLayer(obstacleMarker);
                obstacleMarker = null;
            }
            if(circle)
            {
                map.removeLayer(circle);
                circle = null;
            }
            if(line)
            {
                map.removeLayer(line);
                line = null;
                latlngsLine = [];
            }

            if(type === 'point') 
            {
                obstacleMarker = L.marker(e.latlng).addTo(map); // Add simple marker
              
            }
            else if(type === 'mast') {
                obstacleMarker = L.marker(e.latlng, {icon: mastIcon}).addTo(map);  // Add mast icon marker
            }
                
            else if(type === 'area') 
            {
                const radiusInput = document.getElementById('ObstacleRadius');
                const radiusHidden = document.getElementById('ObstacleRadiusHidden');
                const radius = parseFloat(radiusInput.value) || 300; // Default radius if not set
                circle = L.circle(e.latlng, {color: 'red', fillColor: '#f03', fillOpacity: 0.5, radius: radius}).addTo(map); // Add circle with radius

                document.getElementById('ObstacleGeometry').value = JSON.stringify({
                    center: [ [e.latlng.lat, e.latlng.lng] ],
                    radius: radius
                }); // Update geometry field

                document.getElementById('ObstacleRadius').value = radius; // Update radius field
                document.getElementById('ObstacleLatitude').value = e.latlng.lat.toFixed(6);
                document.getElementById('ObstacleLongitude').value = e.latlng.lng.toFixed(6);
                    
            }

            else if(type === 'line' || type === 'cable') // Draw line by adding points on each click
            {
                latlngsLine.push(e.latlng); // Add clicked point to line array
                
                if(latlngsLine.length > 1) // Draw line if more than 1 point
                {
                    if(line) map.removeLayer(line);
                    line = L.polyline(latlngsLine, {color: '#555555', weight: 3, dashArray: '8, 6' }).addTo(map);          
                }

                let totalLength = 0;

                // Calculate total line length
                for(let i=1; i<latlngsLine.length; i++) {
                    totalLength += latlngsLine[i-1].distanceTo(latlngsLine[i]); // in meters
                }

                document.getElementById('ObstacleGeometry').value=JSON.stringify(latlngsLine); // Update geometry field
                document.getElementById('ObstacleLineLength').value = totalLength.toFixed(2); // Update length field
            }

            if(type === 'point' || type === 'mast') // For point and mast, update fields directly
            {
            document.getElementById('ObstacleGeometry').value = JSON.stringify([ [e.latlng.lat, e.latlng.lng] ]); 
            document.getElementById('ObstacleLatitude').value = e.latlng.lat.toFixed(6);   
            document.getElementById('ObstacleLongitude').value = e.latlng.lng.toFixed(6);
            }
               
            obstacleMarker.on('click', function() { 
                 map.removeLayer(obstacleMarker); 
                 obstacleMarker=null;
                 document.getElementById('ObstacleGeometry').value = '';
                 document.getElementById('ObstacleLatitude').value = '';
                 document.getElementById('ObstacleLongitude').value = '';
            });         
        });

        // Set submit type
        window.setSubmitType = function(value) {
            document.getElementById('submitType').value = value;
        }   
            // HelicopterIcon
                var helicopterIcon = L.icon({
                    iconUrl: '/images/helicopter.svg',
                    iconSize: [60, 60],
                    iconAnchor: [30, 30]
                });

        // Geolocation
        if('geolocation' in navigator) {
            navigator.geolocation.watchPosition(function(pos) {
                var lat = pos.coords.latitude;
                var lng = pos.coords.longitude;

                map.setView([lat, lng], 14);         

                if (!helicopterMarker) {
                    helicopterMarker = L.marker([lat, lng], { icon: helicopterIcon }).addTo(map);
                } else {
                    helicopterMarker.setLatLng([lat, lng]);
                }             
            });
        }

        // Update map size after load
        window.addEventListener('resize', function(){ map.invalidateSize(); });
    });
</script>
