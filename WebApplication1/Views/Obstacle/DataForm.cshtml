@using WebApplication1.Models.Entities
<!-- Obstacle Registration Form with Leaflet map.
    Lat/Lng location auto-filled from map click or browser geolocation (auto-centered if permitted). -->
@model ValidatedObstacleData

@{
    ViewData["Title"] = "Obstacle Registration";
}

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<!-- Custom page CSS -->
<link rel="stylesheet" href="~/css/shared.css" />
<link rel="stylesheet" href="~/css/obstacleForm.css" />


<!-- Map on rightside -->
<div class="map-container">
    <div id="map" class="map-box"></div>

    <button id="locateUserBtn" class="locate-btn">📍</button>

    <!-- choose an obstacle type -->
    <div class="obstacle-button-container">
        <div class="obstacle-title">Choose Obstacle</div>
        <button type="button" class="obstacle-button" data-type="point">
            <img src="/icons/point.svg" alt="Point icon" class="button-icon" />
            Point
        </button>

        <button type="button" class="obstacle-button" data-type="line">
            <img src="/icons/line-chart.svg" alt="Line icon" class="button-icon" />
            Line
        </button>

        <button type="button" class="obstacle-button" data-type="area">
            <img src="/icons/circle.svg" alt="Circle icon" class="button-icon" />
            Area
        </button>
    </div>
</div>

@{

    bool isEditing = ViewBag.IsEditing != null && (bool)ViewBag.IsEditing;

    bool isDraft = Model?.IsDraft ?? true;
    string reportStatus = ViewBag.ReportStatus as string ?? (isDraft ? "Draft" : "Pending");
    string reviewMessage = ViewBag.ReviewMessage as string ?? string.Empty;
    string statusBadge = "bg-yellow-100 text-yellow-800";
    if (reportStatus.Equals("Approved", System.StringComparison.OrdinalIgnoreCase))
    {
        statusBadge = "bg-green-100 text-green-800";
    }
    else if (reportStatus.Equals("Rejected", System.StringComparison.OrdinalIgnoreCase))
    {
        statusBadge = "bg-red-100 text-red-800";
    }
    else if (reportStatus.Equals("More info required", System.StringComparison.OrdinalIgnoreCase))
    {
        statusBadge = "bg-orange-100 text-orange-800";
    }

    bool disableEditing = isEditing && !isDraft && !reportStatus.Equals("More info required", StringComparison.OrdinalIgnoreCase);
}

<div class="flex-container">
    <div class="form-container">
        @if (ViewBag.IsRegistrarViewer != null && (bool)ViewBag.IsRegistrarViewer)
        {
            <div class="mb-6 rounded-md border border-yellow-300 bg-yellow-50 p-4 text-center text-sm text-yellow-900">
                Only pilots can create or save obstacle reports. You can review the form, but submissions will be rejected.
            </div>
        }
        <h1 class="mb-6 text-center text-2xl font-bold sm:text-3xl">
            @(isEditing ? "Edit Obstacle Report" : "Obstacle Registration Form")
        </h1>

        @if (isEditing)
        {
            <div class="mb-4 flex items-center justify-center gap-2 text-sm">
                <span class="rounded px-3 py-1 font-semibold @statusBadge">@reportStatus</span>
                @if (!string.IsNullOrWhiteSpace(reviewMessage))
                {
                    <span class="text-gray-700">— @reviewMessage</span>
                }
            </div>
        }

        <!-- Delete obstacle button -->
        <div class="mb-4 sm:col-span-2">
            <button type="button" id="deleteObstacleButton"
                    class="button-dark-red rounded px-6 py-3"
                    style="display:none;">
                Delete Obstacle
            </button>
        </div>

        <!-- Form -->
        <form asp-controller="Obstacle" asp-action="DataForm" method="post" enctype="multipart/form-data" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="submitType" id="submitType" value="Submit" />
            <input asp-for="ReportID" type="hidden" />
            <input asp-for="ObstacleID" type="hidden" />

            <!-- Hidden fields for geometry -->
            <input asp-for="ObstacleGeoJson" id="ObstacleGeoJson" type="hidden" />
            <input asp-for="ObstacleType" id="ObstacleTypeHidden" type="hidden" />

            <input asp-for="ImagePath" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="mb-2 text-sm text-red-600 sm:col-span-2"></div>

            <div class="mb-4 sm:col-span-2" id="latContainer" style="display:none;">
                <label asp-for="ObstacleLatitude" class="mb-1 block font-medium text-gray-700">Latitude</label>
                <input asp-for="ObstacleLatitude" id="ObstacleLatitude" type="number" step="any" class="w-full rounded border border-gray-300 p-2" placeholder="Auto-filled for point and area" readonly />
            </div>

            <div class="mb-4 sm:col-span-2" id="lngContainer" style="display:none;">
                <label asp-for="ObstacleLongitude" class="mb-1 block font-medium text-gray-700">Longitude</label>
                <input asp-for="ObstacleLongitude" id="ObstacleLongitude" type="number" step="any" class="w-full rounded border border-gray-300 p-2" placeholder="Auto-filled for point and area" readonly />
            </div>


            <!-- Area radius input, shown only if "area" is selected -->
            <div class="mb-4 sm:col-span-2" id="areaRadiusContainer" style="display:none;">
                <label asp-for="ObstacleRadius" class="mb-1 block font-medium text-gray-700"> Area Radius (optional, default 300 meters) </label>
                <input asp-for="ObstacleRadius" type="number" step="any" class="w-full rounded border border-gray-300 p-2" placeholder="300" />
                <span asp-validation-for="ObstacleRadius" class="text-sm text-red-500"></span>
            </div>

            <!-- Line length input-->
            <div class="mb-4 sm:col-span-2" id="lineLengthContainer" style="display:none;">
                <label asp-for="ObstacleLineLength" class="mb-1 block font-medium text-gray-700">Line Length (meters)</label>
                <input asp-for="ObstacleLineLength" type="number" step="any" class="w-full rounded border border-gray-300 p-2" placeholder="e.g., 2.5" />
                <span asp-validation-for="ObstacleLineLength" class="text-sm text-red-500"></span>
            </div>

            <div class="mb-4 sm:col-span-2" id="lineCoordinatesContainer" style="display:none;">
                <label asp-for="ObstacleLineCoordinates" class="mb-1 block font-medium text-gray-700">Line Coordinates</label>
                <textarea asp-for="ObstacleLineCoordinates" id="ObstacleLineCoordinates" type="text" step="any" class="w-full rounded border border-gray-300 p-2" placeholder=" Auto-filled for line" readonly></textarea>
            </div>

            <div class="sm:col-span-2">
                <label asp-for="ObstacleName" class="required mb-1 block font-medium text-gray-700">Obstacle Name</label>
                <input asp-for="ObstacleName" class="w-full rounded border border-gray-300 p-2" placeholder="e.g., Wall, Ramp" />
                <span asp-validation-for="ObstacleName" class="text-sm text-red-500"></span>
            </div>

            <div class="sm:col-span-2">
                <label asp-for="ObstacleHeight" class="mb-1 block font-medium text-gray-700">Obstacle Height (meters)</label>
                <input asp-for="ObstacleHeight" type="number" step="any" class="w-full rounded border border-gray-300 p-2" placeholder="e.g., 2.5" />

                <div class="mb-4 text-sm text-gray-500">
                    Obstacles ≥15 m must be registered (≥30 m in densely built areas).<br>
                    Lower obstacles optional.<br>
                    All power/signal lines with poles must be reported.
                </div>
                <span asp-validation-for="ObstacleHeight" class="text-sm text-red-500"></span>
            </div>

            <div class="sm:col-span-2">
                <label asp-for="ObstacleDescription" class="required mb-1 block font-medium text-gray-700">Obstacle Description</label>
                <textarea asp-for="ObstacleDescription" class="h-96 w-full rounded border border-gray-300 p-2" placeholder="Describe the obstacle, meterials, location, etc."></textarea>
                <span asp-validation-for="ObstacleDescription" class="text-sm text-red-500"></span>
            </div>

            <!-- Has light checkbox -->
            <div class="sm:col-span-2">
                <label class="inline-flex items-center">
                    <input asp-for="ObstacleHasLight" type="checkbox" class="h-11 w-11 rounded border-gray-300">
                    <span class="ml-2 text-gray-700">Check the box if obstacle have light</span>
                </label>
            </div>

            <!-- Image upload -->
            <div class="sm:col-span-2">
                <label for="ObstacleImage" class="mb-1 block font-medium text-gray-700">Upload Image</label>
                <input type="file" name="imageFile" id="ObstacleImage" class="w-full rounded border border-gray-300 p-2" />

                @if (!string.IsNullOrWhiteSpace(Model?.ImagePath))
                {
                    <div class="mt-2 flex items-center gap-3">
                        <img src="@Model.ImagePath" alt="Existing obstacle image" class="max-h-32 rounded border" />
                        <span class="text-sm text-gray-600">Upload a new file to replace the current image.</span>
                    </div>
                }

                <!-- Image preview + delete -->
                <div id="imageContainer" class="mt-2 hidden">
                    <img id="imagePreview" class="max-h-60 rounded border border-gray-300" />
                    <button type="button" id="removeImageButton"
                            class="button-dark-red" px-6 py-3 rounded">
                        Remove Image
                    </button>
                </div>
            </div>

            @if (!isEditing || isDraft)
            {
                <div class="status-warning mb-4 rounded p-4">
                    <strong>⚠ Warning:</strong> You must complete all required fields marked with <strong>*</strong> before submitting the form. <br> You may leave them blank if you choose to save as a draft.
                </div>
            }

            <div class="button-group center-button sm:col-span-2">
                @if (isEditing)
                {
                    if (isDraft || reportStatus.Equals("More info required", StringComparison.OrdinalIgnoreCase))
                    {
                        <button type="submit" onclick="setSubmitType('Submit')" class="button-dark-green rounded px-6 py-3">
                            Submit Data
                        </button>
                        <button type="submit" onclick="setSubmitType('SaveDraft'); return true;" class="button-dark-blue rounded px-6 py-3">
                            Save Draft
                        </button>
                    }
                    else
                    {
                        <a asp-controller="Reports" asp-action="Index" class="button-white-blue inline-block rounded px-6 py-3">
                            <span>⬅️ Go Back</span>
                        </a>
                    }
                }
                else
                {
                    <button type="submit" onclick="setSubmitType('Submit')" class="button-dark-green rounded px-6 py-3">
                        Submit Data
                    </button>
                    <button type="submit" onclick="setSubmitType('SaveDraft'); return true;" class="button-dark-blue rounded px-6 py-3">
                        Save Draft
                    </button>
                }
            </div>

        </form>
    </div>
</div>

@if (disableEditing)
{
    <div class="status-warning-top">
        <strong>⚠ Warning:</strong> You cannot edit this obstacle report because it has already been submitted for review.
    </div>

    <script>
        // Disable all form inputs if editing is disabled
        document.addEventListener('DOMContentLoaded', function () {
            const formElements = document.querySelectorAll('form input, form textarea, form select, form button');
            formElements.forEach(element => {
                element.disabled = true;
            });
        });
    </script>
}


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/obstacleForm.js"></script>
}

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

