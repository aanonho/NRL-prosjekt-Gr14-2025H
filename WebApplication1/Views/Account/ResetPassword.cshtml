@{ ViewData["Title"] = "Password reset"; }
<section class="stack" style="max-width:560px;">
    <h2>Password reset</h2>
    <p class="help">Your password has been changed. You can sign in now.</p>
    <div class="button-group">
        <a asp-action="Login" class="button-link button-dark-blue">Go to Login</a>
    </div>
</section>