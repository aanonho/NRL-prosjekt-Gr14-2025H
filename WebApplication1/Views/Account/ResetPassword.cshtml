@model WebApplication1.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset password";
}

<link rel="stylesheet" href="~/css/shared.css" />

<div class="container mx-auto mt-8 py-8 px-4 bg-white form-container max-w-xl">
    <h1 class="mb-6 text-center text-2xl font-bold text-gray-800 sm:text-3xl">Choose a new password</h1>
    <p class="mb-6 text-center text-gray-600">Your new password must meet the same security requirements as when you registered.</p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 rounded border border-red-200 bg-red-50 p-3 text-sm text-red-700">
            @TempData["ErrorMessage"]
        </div>
    }

    <form asp-action="ResetPassword" method="post" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />

        <div class="flex flex-col">
            <label asp-for="Password" class="mb-1 font-medium text-gray-700">New password</label>
            <input asp-for="Password" class="rounded border border-gray-300 p-2" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="ConfirmPassword" class="mb-1 font-medium text-gray-700">Confirm password</label>
            <input asp-for="ConfirmPassword" class="rounded border border-gray-300 p-2" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-sm text-red-500"></span>
        </div>

        <div class="button-group center-button">
            <button type="submit" class="button-dark-blue px-6 py-3 rounded">Update password</button>
        </div>
    </form>

    <div class="mt-4 text-center text-sm">
        <a asp-action="Login" class="text-blue-800 hover:underline">Back to sign in</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
