@model WebApplication1.Controllers.AccountController.ForgotPasswordVm
@{ ViewData["Title"] = "Forgot password"; }
<section class="stack" style="max-width:560px;">
    <h2>Forgot password</h2>
    <p class="help">Enter your email and we'll send you a reset link.</p>

    <form asp-action="ForgotPassword" method="post" class="stack">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="field-validation-error"></div>

        <div class="field">
            <label for="Email" class="required">Email</label>
            <input asp-for="Email" id="Email" inputmode="email" autocomplete="email" placeholder="you@example.com" />
        </div>

        <div class="button-group">
            <button type="submit" class="button-dark-yellow">Send reset link</button>
            <a asp-action="Login" class="button-link button-dark-blue">Back to Login</a>
        </div>
    </form>
</section>