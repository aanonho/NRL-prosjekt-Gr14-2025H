﻿@* Side for å bestille e-post med lenke for å tilbakestille passord. *@
@model WebApplication1.Models.ForgotPasswordViewModel

@{
    @* Setter tittel som brukes i layouten og for eventuelle lenker tilbake. *@
    ViewData["Title"] = "Forgot password";
}

<link rel="stylesheet" href="~/css/shared.css" />

@* Wrapper som sentrerer skjemaet og gir bakgrunn slik at meldinger står tydelig frem. *@
<div class="container mx-auto mt-8 py-8 px-4 bg-white form-container max-w-xl">
    <h1 class="mb-6 text-center text-2xl font-bold text-gray-800 sm:text-3xl">Reset your password</h1>
    <p class="mb-6 text-center text-gray-600">Enter your email address and we will send a secure link to reset your password.</p>

    @* Viser bekreftelse når lenken er sendt og bruker ikke trenger å prøve på nytt. *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 rounded border border-green-200 bg-green-50 p-3 text-sm text-green-700">
            @TempData["SuccessMessage"]
        </div>
    }

    @* Feilmeldinger gir rask tilbakemelding dersom e-posten ikke ble funnet eller mislyktes. *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 rounded border border-red-200 bg-red-50 p-3 text-sm text-red-700">
            @TempData["ErrorMessage"]
        </div>
    }

    @* Skjemaet poster e-posten brukeren skriver inn og viser valideringsstatus om nødvendig. *@
    <form asp-action="ForgotPassword" method="post" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

        @* Felt for å hente e-postadressen knyttet til kontoen. *@
        <div class="flex flex-col">
            <label asp-for="Email" class="mb-1 font-medium text-gray-700">Email</label>
            <input asp-for="Email" class="rounded border border-gray-300 p-2" autocomplete="email" />
            <span asp-validation-for="Email" class="text-sm text-red-500"></span>
        </div>

        @* Knapp som sender reset-forespørselen, bredden holder layouten balansert. *@
        <div class="button-group center-button">
            <button type="submit" class="button-dark-blue px-6 py-3 rounded" style="width: 200px;">Send Reset Link</button>
        </div>
    </form>

    @* Lenker som lar brukeren gå tilbake til innlogging eller registrere en ny konto. *@
    <div class="mt-4 flex justify-between text-sm text-blue-800">
        <a asp-action="Login" class="hover:underline">Back to sign in</a>
        <a asp-controller="User" asp-action="UserForm" class="hover:underline">Create new account</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}