@model WebApplication1.Models.UserData

@{
    ViewData["Title"] = "User Registration";
}

<div class="container mx-auto mt-8 px-4">
    <h1 class="mb-6 text-center text-2xl font-bold text-gray-800 sm:text-3xl">User Registration Form</h1>
    <p class="mb-6 text-center text-gray-600">Please enter your information:</p>
    @* Made to take data from UserForm to User page *@
    <form asp-action="UserForm" method="post" novalidate class="mx-auto grid grid-cols-1 gap-6 sm:grid-cols-2">

        <div class="flex flex-col">
            <label asp-for="Name" class="mb-1 font-medium text-gray-700">Name</label>
            <input asp-for="Name" class="rounded border border-gray-300 p-2 focus:ring-2 focus:ring-green-500 focus:outline-none" />
            <span asp-validation-for="Name" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Email" class="mb-1 font-medium text-gray-700">Email</label>
            <input asp-for="Email" type="email" class="rounded border border-gray-300 p-2 focus:ring-2 focus:ring-green-500 focus:outline-none" />
            <span asp-validation-for="Email" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Phone" class="mb-1 font-medium text-gray-700">Phone</label>
            <input asp-for="Phone" type="tel" class="rounded border border-gray-300 p-2 focus:ring-2 focus:ring-green-500 focus:outline-none" />
            <span asp-validation-for="Phone" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Address" class="mb-1 font-medium text-gray-700">Address</label>
            <input asp-for="Address" class="rounded border border-gray-300 p-2 focus:ring-2 focus:ring-green-500 focus:outline-none" />
            <span asp-validation-for="Address" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Role" class="mb-1 font-medium text-gray-700">Role</label>
            <select asp-for="Role" class="rounded border border-gray-300 p-2 focus:ring-2 focus:ring-green-500">
                <option value="">Select Role..</option>
                <option>Registrar</option>
                <option>Pilot</option>
            </select>
            <span asp-validation-for="Role" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Organization" class="mb-1 font-medium text-gray-700">Organization</label>
            <input asp-for="Organization" class="rounded border border-gray-300 p-2 focus:ring-2 focus:ring-green-500" />
            <span asp-validation-for="Organization" class="text-sm text-red-500"></span>
        </div>

        <div class="mt-4 flex justify-center sm:col-span-2">
            <button type="submit" class="rounded bg-green-500 px-6 py-2 font-semibold text-white hover:bg-green-600">
                Submit Data
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
