@model WebApplication1.Models.UserData
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "User Registration";
}

<!-- Custom page CSS -->
<link rel="stylesheet" href="~/css/shared.css" />

<div class="form-container container mx-auto mt-8 bg-white px-4 py-8">
    <h1 class="mb-6 text-center text-2xl font-bold text-gray-800 sm:text-3xl">User Registration Form</h1>
    <p class="mb-6 text-center text-gray-600">Please enter your information:</p>
    @* Made to take data from UserForm to User page *@
    <form asp-action="UserForm" method="post" novalidate class="mx-auto grid grid-cols-1 gap-6 sm:grid-cols-2">

        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 sm:col-span-2"></div>

        <div class="flex flex-col">
            <label asp-for="Name" class="required mb-1 font-medium text-gray-700">Name</label>
            <input asp-for="Name" class="rounded border border-gray-300 p-2" />
            <span asp-validation-for="Name" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Email" class="required mb-1 font-medium text-gray-700">Email</label>
            <input asp-for="Email" type="email" class="rounded border border-gray-300 p-2" />
            <span asp-validation-for="Email" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Phone" class="required mb-1 font-medium text-gray-700">Phone</label>
            <input asp-for="Phone" id="Phone" type="tel" class="rounded border border-gray-300 p-2" />
            <span class="text-xs text-gray-500">Format: +47 12345678 or 12345678</span>
            <span asp-validation-for="Phone" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Address" class="mb-1 font-medium text-gray-700">Address</label>
            <input asp-for="Address" class="rounded border border-gray-300 p-2" />
            <span asp-validation-for="Address" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Role" class="required mb-1 font-medium text-gray-700">Role</label>
            <select asp-for="Role" class="rounded border border-gray-300 p-2">
                <option value="">Select Role..</option>
                <option>Registrar</option>
                <option>Pilot</option>
            </select>
            <span asp-validation-for="Role" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Organization" class="mb-1 font-medium text-gray-700">Organization</label>
            <select asp-for="Organization" asp-items="@(ViewBag.OrganizationOptions as IEnumerable<SelectListItem>)" class="rounded border border-gray-300 p-2">
                <option value="">Select organization...</option>
            </select>
            <span asp-validation-for="Organization" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Password" class="required mb-1 font-medium text-gray-700">Password</label>
            <input asp-for="Password" type="password" autocomplete="new-password" class="rounded border border-gray-300 p-2" />
            <span class="text-xs text-gray-500">Password must be 8 characters or more</span>
            <span asp-validation-for="Password" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="ConfirmPassword" class="required mb-1 font-medium text-gray-700">Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="rounded border border-gray-300 p-2" />
            <span asp-validation-for="ConfirmPassword" class="text-sm text-red-500"></span>
        </div>

        <div class="button-group center-button sm:col-span-2">
            <button type="submit" onclick="setSubmitType('Submit')" class="button-dark-green" px-6 py-3 rounded">
                Register
            </button>
            <a asp-controller="Account" asp-action="Login" class="button-white-blue inline-block rounded px-6 py-3">
                <span> ⬅️ Back to Home Page</span>
            </a>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const phoneInput = document.getElementById("Phone");

                phoneInput.addEventListener("input", function () {
                    let v = this.value.replace(/\D/g, "");

                    if (v.startsWith("47")) {
                        v = "+47 " + v.substring(2);
                    } else if (v.startsWith("0047")) {
                        v = "+47 " + v.substring(4);
                    }

                    this.value = v;
                });
            });
        </script>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
