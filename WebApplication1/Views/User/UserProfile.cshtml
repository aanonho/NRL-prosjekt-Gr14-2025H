@model WebApplication1.Models.UserData
@{
    ViewData["Title"] = "User Profile";
}

<div class="min-h-screen bg-gray-100 flex flex-col items-center py-10 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-md sm:max-w-lg md:max-w-2x1 bg-white shadow-2xl rounded-2x1 p-6 sm:p-8 md:p-10">
        <h1 class="text-2x1 sm:text-3xl font-bold text-center mb-8">User Profile</h1>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
                <label class="block font-semibold text-gray-700 mb-1">Name</label>
                <div class="p-3 bg-gray-50 rounded border border-gray-200">@Model.Name</div>
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">E-mail</label>
                <div class="p-3 bg-gray-50 rounded border border-gray-200">@Model.Email</div>
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Phone Number</label>
                <div class="p-3 bg-gray-50 rounded border border-gray-200">@Model.Phone</div>
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Address</label>
                <div class="p-3 bg-gray-50 rounded border border-gray-200">@Model.Address</div>
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Role</label>
                <div class="p-3 bg-gray-50 rounded border border-gray-200">@Model.Role</div>
            </div>

            <div>
                <label class="block font-semibold text-gray-700 mb-1">Organization</label>
                <div class="p-3 bg-gray-50 rounded border border-gray-200">@Model.Organization</div>
            </div>
        </div>

        <div class="mt-10 text-center">
            <a asp-controller="Home" asp-action="Index"
            class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-xl transition-all duration-200">
                Back to Homepage
            </a>
        </div>
    </div>
</div>
