@model WebApplication1.Models.UserProfileViewModel
@{
    ViewData["Title"] = "User Profile";
}

<link rel="stylesheet" href="~/css/shared.css" />

<div class="container mx-auto mt-6 px-4">
    <div class="overflow-hidden rounded-lg bg-white shadow-md">
        <div id="header" class="flex items-center justify-between px-4 py-3 text-white">
            <h1 class="text-xl font-bold sm:text-2xl">Personal Information</h1>
           @*  <span class="text-sm font-medium opacity-90">@Model.RoleDisplay</span> *@
        </div>

        <div class="p-6 sm:p-10">
            @if (!Model.HasUser)
            {
                <div class="rounded border border-yellow-300 bg-yellow-50 p-4 text-center text-yellow-800">
                    We couldn't load your profile details. Please try signing in again.
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                    <div class="field-container">
                        <label>Name</label>
                        <div class="input-box">@(!string.IsNullOrWhiteSpace(Model.Name) ? Model.Name : "Unknown")</div>
                    </div>
                    <div class="field-container">
                        <label>E-mail</label>
                        <div class="input-box">@Model.Email</div>
                    </div>
                    <div class="field-container">
                        <label>Phone Number</label>
                        <div class="input-box">@(!string.IsNullOrWhiteSpace(Model.Phone) ? Model.Phone : "Unavailable")</div>
                    </div>
                    <div class="field-container">
                        <label>Role</label>
                        <div class="input-box">@Model.RoleDisplay</div>
                    </div>
                    <div class="field-container">
                        <label>Organization</label>
                        <div class="input-box">@Model.OrganizationDisplay</div>
                    </div>
                </div>
            }
    
            <div class="button-group center-button">
                <a asp-controller="Reports" asp-action="Index" class="button-dark-blue px-6 py-3 rounded inline-block">
                    View Reports
                </a>
                <a asp-controller="Obstacle" asp-action="DataForm" class="button-white-blue px-6 py-3 rounded inline-block">
                    Back to Obstacle Registration
                </a>
            </div>         
        </div>
    </div>
</div>
