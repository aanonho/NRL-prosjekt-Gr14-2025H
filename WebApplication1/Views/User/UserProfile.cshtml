@model IEnumerable<WebApplication1.Models.ReportItem>
@using WebApplication1.Models
@{
    ViewData["Title"] = "User Profile";
    var user = ViewBag.User as UserData;
}

<div class="flex min-h-screen flex-col items-center bg-gray-50 px-4 py-10 sm:px-6 lg:px-8">
    <div class="w-full max-w-3xl rounded-2xl bg-white p-6 shadow-xl ring-1 ring-gray-200 sm:p-10">
        <h1 class="mb-8 text-center text-3xl font-bold text-blue-700">User Profile</h1>

        @if (user != null)
        {
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                @foreach (var field in new[]
                            {
                        new { Label = "Name", Value = user.Name },
                        new { Label = "E-mail", Value = user.Email },
                        new { Label = "Phone Number", Value = user.Phone },
                        new { Label = "Address", Value = user.Address },
                        new { Label = "Role", Value = user.Role },
                        new { Label = "Organization", Value = user.Organization }
                        })
                {
                    <div>
                        <label class="mb-1 block font-semibold text-gray-700">@field.Label</label>
                        <div class="rounded-lg border border-gray-200 bg-gray-50 p-3 shadow-sm">@field.Value</div>
                    </div>
                }
            </div>
        }

        <div class="mt-12">
            <h2 class="mb-4 border-b pb-2 text-2xl font-semibold text-gray-800">Submitted Reports</h2>

            @if (Model == null || !Model.Any())
            {
                <p class="text-gray-500">No reports submitted yet.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full overflow-hidden rounded-lg border border-gray-200">
                        <thead class="bg-blue-600 text-sm text-white uppercase">
                            <tr>
                                <th class="px-4 py-2 text-left font-semibold">Created</th>
                                <th class="px-4 py-2 text-left font-semibold">Status</th>
                                <th class="px-4 py-2 text-left font-semibold">Description</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 bg-white">
                            @foreach (var report in Model)
                            {
                                <tr class="transition hover:bg-blue-50">
                                    <td class="px-4 py-2 text-gray-700">@report.CreatedAt.ToString("g")</td>
                                    <td class="px-4 py-2 font-semibold">
                                        <span class="@(
                                              report.Status == "Approved" ? "text-green-600" :
                                              report.Status == "Rejected" ? "text-red-600" : "text-yellow-600")">
                                    @report.Status
                                </span>
                            </td>
                            <td class="px-4 py-2 text-gray-700">@report.Obstacle?.ToString() ?? "No description"</td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="mt-10 text-center">
            <a asp-controller="Home" asp-action="Index"
               class="inline-block rounded-xl bg-blue-600 px-6 py-2 font-semibold text-white transition hover:bg-blue-700">
                Back to Homepage
            </a>
        </div>
    </div>
</div>
