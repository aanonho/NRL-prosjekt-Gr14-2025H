@{
    ViewData["Title"] = "Portal";
}

<section class="stack">
    <h1 class="text-3xl font-bold mb-4">Welcome to Kartvertet</h1>
    <p class="help mb-6">
        Sign in with your email. You can create an account or recover your password anytime.
    </p>
    
    

    <div class="row mt-6">
        <!-- Login card -->
        <article class="card stack">
            <h3 class="text-xl font-semibold">Sign in</h3>
            <p class="help">Access your dashboard and services.</p>
            <div class="button-group center-button">
                <a href="/Account/Login" class="button-link button-dark-blue">Go to Login</a>
            </div>
        </article>

        <!-- Create Account card -->
        <article class="card stack">
            <h3 class="text-xl font-semibold">Create account</h3>
            <p class="help">Use any valid email address.</p>
            <div class="button-group center-button">
                <a href="/Account/Register" class="button-link button-dark-green">Create Account</a>
            </div>
        </article>
    </div>

   
</section>