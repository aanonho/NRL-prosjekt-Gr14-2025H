@model WebApplication1.Models.ReportsIndexViewModel

@{
    ViewData["Title"] = "Reports";
}

<div class="container mx-auto mt-6 px-4">
    <div class="overflow-hidden rounded-lg bg-white shadow-md">
        <!-- Header -->
        <div class="flex items-center justify-between bg-green-500 px-4 py-3 text-white">
            <h1 class="text-xl font-bold sm:text-2xl">Raports</h1>
            <p class="text-sm opacity-90">
                Showing <strong>@Model.FilteredCount</strong> of <strong>@Model.TotalCount</strong> reports —
                <span class="text-green-100">Submitted:</span> <strong>@Model.SubmittedCount</strong>,
                <span class="text-yellow-100">Drafts:</span> <strong>@Model.DraftCount</strong>
            </p>
        </div>

        <!-- Filters -->
        <form method="get" class="grid grid-cols-1 gap-4 border-b p-4 sm:grid-cols-3">
            <!-- Status -->
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Status</label>
                <select name="status" class="w-full rounded border border-gray-300 p-2">
                    <option value="all" selected="@(Model.Status == "all")">All</option>
                    <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                    <option value="Approved" selected="@(Model.Status == "Approved")">Approved</option>
                    <option value="Rejected" selected="@(Model.Status == "Rejected")">Rejected</option>
                    <option value="submitted" selected="@(Model.Status == "submitted")">Submitted</option>
                    <option value="draft" selected="@(Model.Status == "draft")">Draft</option>
                </select>
            </div>

            <!-- Sort by date -->
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Date</label>
                <select name="sort" class="w-full rounded border border-gray-300 p-2">
                    <option value="date_desc" selected="@(Model.Sort == "date_desc")">Newest first</option>
                    <option value="date_asc" selected="@(Model.Sort == "date_asc")">Oldest first</option>
                </select>
            </div>

            <!-- Organization -->
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Organization</label>
                <input name="organization"
                       value="@Model.Organization"
                       placeholder="e.g., NLA, Luftforsvaret"
                       class="w-full rounded border border-gray-300 p-2" />
            </div>

            <div class="flex gap-2 sm:col-span-3">
                <button type="submit" class="rounded bg-green-500 px-4 py-2 text-white hover:bg-green-600">Apply</button>
                <a href="@Url.Action("Index", "Reports")" class="rounded border px-4 py-2">Reset</a>
            </div>
        </form>

        <!-- Table -->
        <div class="overflow-x-auto p-4">
            @if (Model.Reports == null || Model.Reports.Count == 0)
            {
                <div class="text-gray-600">No reports found.</div>
            }
            else
            {
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-500 uppercase">Date</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-500 uppercase">Title</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-500 uppercase">Status</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-500 uppercase">Organization</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-500 uppercase">Height (m)</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-500 uppercase">Lat</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-500 uppercase">Lng</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white">
                        @foreach (var r in Model.Reports)
                        {
                            <tr class="hover:bg-gray-50" @(r.IsDraft ? "bg-yellow-100" : "")">
                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-700">
                                    @r.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-800">
                                    @(!string.IsNullOrWhiteSpace(r.Obstacle.ObstacleName) ? r.Obstacle.ObstacleName : "(no title)")
                                </td>
                                <td class="px-3 py-2 whitespace-nowrap">
                                    @{
                                        var status = (r.Status ?? "Pending");
                                        var badge = "bg-yellow-100 text-yellow-800";
                                        if (status.Equals("Approved", System.StringComparison.OrdinalIgnoreCase))
                                        {
                                            badge = "bg-green-100 text-green-800";
                                        }
                                        else if (status.Equals("Rejected", System.StringComparison.OrdinalIgnoreCase))
                                        {
                                            badge = "bg-red-100 text-red-800";
                                        }
                                    }
                                    <span class="rounded px-2 py-1 text-xs @badge">@status</span>
                                    @if (r.IsDraft)
                                    {
                                        <span class="ml-2 rounded bg-yellow-200 px-2 py-1 text-xs text-yellow-900">Draft</span>
                                    }
                                </td>
                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-700">
                                    @(string.IsNullOrWhiteSpace(r.Organization) ? "Unknown" : r.Organization)
                                </td>
                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-700">
                                    @(r.Obstacle.ObstacleHeight?.ToString("0.##") ?? "-")
                                </td>
                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-700">
                                    @(r.Obstacle.ObstacleLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "-")
                                </td>
                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-700">
                                    @(r.Obstacle.ObstacleLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "-")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div> <!-- /.bg-white card -->
</div>     <!-- /.container -->
