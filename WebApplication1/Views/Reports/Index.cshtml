﻿@model WebApplication1.Models.ReportsIndexViewModel
@* Oversikt over rapporter med filter, sortering og rollebaserte handlinger. *@

@{
    ViewData["Title"] = "Reports";
}

<!-- Felles stilark for rapportlisten -->
<link rel="stylesheet" href="~/css/shared.css" />

<div class="container w-full mt-6 px-4">
    <div class="overflow-hidden rounded-lg bg-white shadow-md">
        <!-- Toppseksjon som viser tellinger og filterkontekst -->
        <div id="header" class="flex items-center justify-between px-4 py-3 text-white">
            <h1 class="text-xl font-bold sm:text-2xl">Reports</h1>
            <p class="text-sm opacity-90">
                Showing <strong>@Model.FilteredCount</strong> of <strong>@Model.TotalCount</strong> reports —
                <span class="text-white">Submitted:</span> <strong>@Model.SubmittedCount</strong>,
                <span class="text-white">Drafts:</span> <strong>@Model.DraftCount</strong>
            </p>
        </div>

        @if (Model.IsPilotView && !string.IsNullOrWhiteSpace(Model.CurrentUserEmail))
        {
            <div class="mx-4 mb-4 border border-gray-300 bg-yellow-100 px-4 py-2 text-sm shadow-sm">
                Showing reports submitted by <strong>@Model.CurrentUserEmail</strong>.
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            @*  <div class="m-4 rounded-md border border-green-300 bg-green-50 p-3 text-center font-medium text-green-800 shadow-sm">
                @TempData["SuccessMessage"]
            </div>*@

            <div class="status-confirmed p-4 rounded mb-6 mb-4">
                <strong>✔ Saved:</strong> @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {

            <div class="status-critical p-4 rounded mb-4">
                <strong>⚠ Critical:</strong> @TempData["ErrorMessage"]
            </div>
            @*  <div class="m-4 rounded-md border border-red-300 bg-red-50 p-3 text-center font-medium text-red-800 shadow-sm">
                @TempData["ErrorMessage"]
            </div> *@         
        }

        <!-- Filterpanel for status, dato og organisasjon -->
        <form method="get" class="grid grid-cols-1 gap-4 border-b p-4 sm:grid-cols-3">
            <!-- Statusfilter for å begrense visning -->
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Status</label>
                <select name="status" class="w-full rounded border border-gray-300 p-2">
                    <option value="all" selected="@(Model.Status == "all")">All</option>
                    <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                    <option value="Approved" selected="@(Model.Status == "Approved")">Approved</option>
                    <option value="Rejected" selected="@(Model.Status == "Rejected")">Rejected</option>
                    <option value="More info required" selected="@(Model.Status == "More info required")">More info required</option>
                    <option value="submitted" selected="@(Model.Status == "submitted")">Submitted</option>
                    <option value="draft" selected="@(Model.Status == "draft")">Draft</option>
                </select>
            </div>

            <!-- Sorteringsvalg for dato -->
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Date</label>
                <select name="sort" class="w-full rounded border border-gray-300 p-2">
                    <option value="date_desc" selected="@(Model.Sort == "date_desc")">Newest first</option>
                    <option value="date_asc" selected="@(Model.Sort == "date_asc")">Oldest first</option>
                </select>
            </div>

            <!-- Fritekstsøk på organisasjonsnavn -->
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">Organization</label>
                <input name="organization"
                       value="@Model.Organization"
                       placeholder="e.g., NLA, Luftforsvaret"
                       class="w-full rounded border border-gray-300 p-2" />
            </div>

            <div class="sm:col-span-2 button-group">
                <button type="submit" class="button-dark-blue">Apply</button>
                <button type="button" class="button-white-blue" onclick="location.href='@Url.Action("Index", "Reports")'">Reset</button>
                @*  GAMMELKODE->  <a href="@Url.Action("Index", "Reports")" class="button-dark-yellow">Reset</a> *@
            </div>
        </form>

        <!-- Resultattabell for rapporter med nøkkelfelt -->
        <div class="overflow-x-auto p-4">
            @if (Model.Reports == null || Model.Reports.Count == 0)
            {
                <div class="text-gray-600">No reports found.</div>
            }
            else
            {
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-600 uppercase">Report ID</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-600 uppercase">Date</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-600 uppercase">Obstacle Type</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-600 uppercase">Title</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-600 uppercase">Status</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-600 uppercase">Submitted by</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-600 uppercase">Organization</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-600 uppercase">Height (m)</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-600 uppercase">Coordinates</th>
                            <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-600 uppercase">Image</th>
                            @if (Model.IsPilotView || Model.IsRegistrarView)
                            {
                                <th class="px-3 py-2 text-left text-xs font-medium tracking-wider text-gray-600 uppercase">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white">
                        @foreach (var r in Model.Reports)
                        {
                            var obstacle = r.ReportObstacle;

                            <tr class="hover:bg-gray-50">
                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-800">
                                    @(obstacle?.ObstacleID)
                                </td>
                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-700">
                                    @r.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-800">
                                    @(obstacle?.ObstacleType)
                                </td>

                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-800">
                                    @(obstacle?.ObstacleName ?? "(no title)")
                                </td>

                                <td class="px-3 py-2 whitespace-nowrap">
                                    @{
                                        var status = (r.Status ?? "Pending");
                                        var badge = "bg-yellow-100 text-yellow-800";
                                        if (status.Equals("Approved", System.StringComparison.OrdinalIgnoreCase))
                                            badge = "bg-green-100 text-green-800";
                                        else if (status.Equals("Rejected", System.StringComparison.OrdinalIgnoreCase))
                                            badge = "bg-red-100 text-red-800";
                                        else if (status.Equals("More info required", System.StringComparison.OrdinalIgnoreCase))
                                            badge = "bg-yellow-200 text-yellow-900";
                                        else if (r.IsDraft)
                                            badge = "bg-gray-50 text-gray-800 border border-gray-200";
                                    }
                                    <span class="rounded px-2 py-1 text-xs @badge">@status</span>
                                </td>

                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-700">
                                    @(r.CreatedBy ?? "Unknown")
                                </td>

                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-700">
                                    @(r.Organization ?? r.OrganizationRef?.Name ?? "Unknown")
                                </td>

                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-700">
                                    @(obstacle?.ObstacleHeight?.ToString("0.##") ?? "-")
                                </td>
                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-700">
                                    @if (!string.IsNullOrWhiteSpace(obstacle?.ObstacleLineCoordinates))
                                    {
                                        @Html.Raw(
                                        obstacle.ObstacleLineCoordinates
                                        .Replace("\n", "<br />")
                                        .Replace(", Lng:", "&nbsp;&nbsp;&nbsp;&nbsp;&nbspLng:"))
                                                        }
                                    else if (obstacle?.ObstacleLatitude != null && obstacle?.ObstacleLongitude != null)
                                    {
                                        <span>Lat: @(obstacle?.ObstacleLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture)),</span>
                                        <span style="margin-left:10px;">Lng: @(obstacle?.ObstacleLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-700">
                                    @if (!string.IsNullOrWhiteSpace(obstacle?.ImagePath))
                                    {
                                        var obstacleImages = obstacle.ImagePath
                                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                                        if (obstacleImages.Any())
                                        {
                                            var primaryImage = obstacleImages.First();
                                            var additionalCount = obstacleImages.Count() - 1;

                                            <a href="@primaryImage" target="_blank">
                                                <img src="@primaryImage"
                                                     alt="Obstacle image"
                                                     style="width: 200px; height: auto; object-fit: contain;"
                                                     class="rounded border" />
                                            </a>

                                            if (additionalCount > 0)
                                            {
                                                <div class="text-xs text-gray-600 mt-1">+@additionalCount more image@(additionalCount > 1 ? "s" : string.Empty)</div>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                @if (Model.IsPilotView || Model.IsRegistrarView)
                                {
                                    <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-700">
                                        @{
                                            // Sjekk om rapporten er Approved
                                            var isApproved = string.Equals(r.Status, "Approved", System.StringComparison.OrdinalIgnoreCase);
                                        }

                                        @* PILOT: kan redigere så lenge rapporten IKKE er Approved 
                                        @if (!isApproved && Model.IsPilotView)
                                        {
                                            <a href="@Url.Action("DataForm", "Obstacle", new { id = r.ReportID })"
                                               class="inline-flex items-center space-x-4 py-1 rounded hover:text-green-600">
                                                <img src="~/icons/editIcon.svg" alt="Edit" style="width: 30px; height: 30px;" />
                                                <span>Edit</span>
                                            </a>
                                        }
                                        *@

                                        @if (Model.IsPilotView)
                                        {
                                            if (r.IsDraft || r.Status == "More info required")
                                            {
                                                <a class="button-white-green inline-block px-3 py-2 text-xs"
                                                   href="@Url.Action("DataForm", "Obstacle", new { id = r.ReportID })">
                                                    Edit
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="button-white-blue inline-block px-3 py-2 text-xs"
                                                   href="@Url.Action("DataForm", "Obstacle", new { id = r.ReportID })">
                                                    View
                                                </a>
                                            }
                                        }
                                        @* REGISTRAR: kan alltid Review så lenge det ikke er draft *@
                                        @if (Model.IsRegistrarView && !r.IsDraft)
                                        {
                                            <a class="button-dark-blue inline-block px-3 py-2 text-xs"
                                               href="@Url.Action("Details", "Reports", new { id = r.ReportID })">
                                                Review
                                            </a>
                                        }
                                    </td>

                                    @*
                                    <td class="px-3 py-2 text-sm whitespace-nowrap text-gray-700">
                                        <a class="white inline-block px-3 py-2 text-xs" href="@Url.Action("DataForm", "Obstacle", new { id = r.ReportID })">
                                            Edit
                                        </a>
                                    </td>
                                    *@
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div> <!-- /.bg-white card -->
</div> <!-- /.container -->