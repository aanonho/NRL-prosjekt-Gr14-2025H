@model WebApplication1.Models.ReportItem
@using WebApplication1.Models

@{
    ViewData["Title"] = "Report Details";
    var isRegistrar = User.IsInRole("Registrar");
    var status = Model.Status ?? "Pending";
    var badgeClass = "bg-yellow-100 text-yellow-800";
    if (status.Equals("Approved", System.StringComparison.OrdinalIgnoreCase))
    {
        badgeClass = "bg-green-100 text-green-800";
    }
    else if (status.Equals("Rejected", System.StringComparison.OrdinalIgnoreCase))
    {
        badgeClass = "bg-red-100 text-red-800";
    }
    else if (status.Equals("More info required", System.StringComparison.OrdinalIgnoreCase))
    {
        badgeClass = "bg-yellow-200 text-yellow-900";
    }
}

<link rel="stylesheet" href="~/css/shared.css" />

<div class="container mx-auto mt-8 px-4">
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Report Details</h1>
            <p class="text-sm text-gray-600">Submitted on @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
        </div>
        <span class="rounded px-3 py-1 text-sm font-semibold @badgeClass">@status</span>
    </div>

    <div class="rounded-lg bg-white shadow">
        <div class="border-b px-6 py-4">
            <h2 class="text-lg font-semibold text-gray-800">Report information</h2>
        </div>
        <div class="grid gap-6 px-6 py-4 md:grid-cols-2">
            <div>
                <p class="text-sm font-semibold text-gray-700">Submitted by</p>
                <p class="text-gray-800">@Model.SubmittedByName (@Model.SubmittedByEmail)</p>
            </div>
            <div>
                <p class="text-sm font-semibold text-gray-700">Organization</p>
                @{
                    var organization = string.IsNullOrWhiteSpace(Model.Organization)
                    ? Model.OrganizationRef?.Name
                    : Model.Organization;
                }
                <p class="text-gray-800">@(organization ?? "Unknown")</p>
            </div>
            <div>
                <p class="text-sm font-semibold text-gray-700">Reviewed at</p>
                <p class="text-gray-800">@(Model.ReviewedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Not reviewed")</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ReviewMessage))
            {
                <div class="md:col-span-2">
                    <p class="text-sm font-semibold text-gray-700">Registrar message</p>
                    <p class="mt-1 rounded border border-gray-200 bg-gray-50 p-3 text-gray-800">@Model.ReviewMessage</p>
                </div>
            }
        </div>
    </div>

    @if (Model.ReportObstacle != null)
    {
        <div class="mt-6 rounded-lg bg-white shadow">
            <div class="border-b px-6 py-4">
                <h2 class="text-lg font-semibold text-gray-800">Obstacle information</h2>
            </div>
            <div class="grid gap-6 px-6 py-4 md:grid-cols-2">
                <div>
                    <p class="text-sm font-semibold text-gray-700">Report ID</p>
                    <p class="text-gray-800">@Model.ReportObstacle.ObstacleID</p>
                </div>
                <div>
                    <p class="text-sm font-semibold text-gray-700">Name</p>
                    <p class="text-gray-800">@Model.ReportObstacle.ObstacleName</p>
                </div>
                <div>
                    <p class="text-sm font-semibold text-gray-700">Type of obstacle</p>
                    <p class="text-gray-800">@Model.ReportObstacle.ObstacleType</p>
                </div>
                <div>
                    <p class="text-sm font-semibold text-gray-700">Height (m)</p>
                    <p class="text-gray-800">@Model.ReportObstacle.ObstacleHeight</p>
                </div>
                <div>
                    <p class="text-sm font-semibold text-gray-700">Latitude</p>
                    <p class="text-gray-800">@Model.ReportObstacle.ObstacleLatitude</p>
                </div>
                <div>
                    <p class="text-sm font-semibold text-gray-700">Longitude</p>
                    <p class="text-gray-800">@Model.ReportObstacle.ObstacleLongitude</p>
                </div>
                <div>
                    <p class="text-sm font-semibold text-gray-700">Has lights</p>
                    <p class="text-gray-800">@(Model.ReportObstacle.ObstacleHasLight ? "Yes" : "No")</p>
                </div>
                <div class="md:col-span-2">
                    <p class="text-sm font-semibold text-gray-700">Description</p>
                    <p class="mt-1 rounded border border-gray-200 bg-gray-50 p-3 text-gray-800">@Model.ReportObstacle.ObstacleDescription</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ReportObstacle.ImagePath))
                {
                    var obstacleImages = Model.ReportObstacle.ImagePath
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                    if (obstacleImages.Any())
                    {
                        <div class="md:col-span-2">
                            <p class="text-sm font-semibold text-gray-700">Images</p>
                            <div class="mt-2 flex flex-wrap gap-3">
                                @foreach (var imagePath in obstacleImages)
                                {
                                    <a href="@imagePath" target="_blank" class="inline-block">
                                        <img src="@imagePath" alt="Obstacle image" class="max-h-80 rounded border" />
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }

    @if (Model.ReportObstacle != null)
    {
        <div class="mt-6">
            <h2 class="mb-2 text-lg font-semibold text-gray-800">Obstacle Location</h2>

            <div id="report-map"
                 class="h-96 w-full rounded border shadow"></div>
        </div>
    }


    <div class="mt-6">
        @if (isRegistrar && !Model.IsDraft)
        {
            <!-- Form for å oppdatere status (Approve / Reject / More info) -->
            <form asp-action="UpdateStatus"
                  asp-controller="Reports"
                  method="post"
                  class="w-full max-w-xl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ReportID" />

                <label class="mb-2 block text-sm font-semibold text-gray-700" for="message">
                    Message to pilot (optional)
                </label>
                <textarea name="message"
                      id="message"
                      rows="3"
                      class="w-full rounded-md border border-gray-300 p-2"
                      placeholder="Share context about this decision">@Model.ReviewMessage</textarea>

                <div class="button-group center-button mt-4">
                    <button type="submit"
                            name="status"
                            value="Approved"
                            class="button-dark-green">
                        Approve
                    </button>

                    <button type="submit"
                            name="status"
                            value="Rejected"
                            class="button-dark-red">
                        Reject
                    </button>

                    <button type="submit"
                            name="status"
                            value="More info required"
                            class="button-dark-yellow"
                            style="width:auto; padding:0.4rem 1.2rem; font-size:0.9rem;">
                        Ask for more information
                    </button>
                </div>

            </form>


            <div class="mt-4 w-full flex justify-between items-center">
                <!-- Eget form for å slette rapporten -->
                <form asp-action="Delete"
                      asp-controller="Reports"
                      method="post"
                      class="mt-4 w-full max-w-xl"
                      onsubmit="return confirm('Are you sure you want to delete this report permanently?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ReportID" />

                    <button type="submit"
                            class="button-dark-red">
                        Delete report
                    </button>
                </form>

                <a href="@Url.Action("Index", "Reports")" class="button-white-blue" style="width:170px; text-align:center;">
                    ⬅️ Back to list
                </a>
        </div>
        }     
    </div>
</div>

@section Scripts {
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin="">
    </script>

            @{
             var flatObstacle = new {
                ObstacleLatitude = Model.ReportObstacle?.ObstacleLatitude,
                ObstacleLongitude = Model.ReportObstacle?.ObstacleLongitude,
                ObstacleType = Model.ReportObstacle?.ObstacleType,
                ObstacleRadius = Model.ReportObstacle?.ObstacleRadius,
                ObstacleGeoJson = Model.ReportObstacle?.ObstacleGeoJson,
                ObstacleLineCoordinates = Model.ReportObstacle?.ObstacleLineCoordinates,
                ObstacleHasLight = Model.ReportObstacle?.ObstacleHasLight,
                ObstacleHeight = Model.ReportObstacle?.ObstacleHeight,
                ObstacleName = Model.ReportObstacle?.ObstacleName,
                ObstacleDescription = Model.ReportObstacle?.ObstacleDescription
             };
             }

    <script>
            document.addEventListener("DOMContentLoaded", function () {
            const obstacle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(flatObstacle));


            const mapDiv = document.getElementById("report-map");
            if (!mapDiv || !obstacle) return;

            // Default map position
            const map = L.map("report-map").setView([64.5, 11.0], 5);

            L.tileLayer("https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png", {
                maxZoom: 17
            }).addTo(map);

            // POINT / AREA
            if (obstacle.obstacleLatitude && obstacle.obstacleLongitude) 
            {
                const lat = obstacle.obstacleLatitude;
                const lng = obstacle.obstacleLongitude;

                // Area circle
                if (obstacle.obstacleType === "area") 
                {
                    const radius = obstacle.obstacleRadius || 300;
                    L.circle([lat, lng], {
                        radius: radius,
                        color: "red",
                        fillColor: "#f03",
                        fillOpacity: 0.5
                    }).addTo(map);
                    map.setView([lat, lng], 15);
                }

                // Point marker
                else if (obstacle.obstacleType === "point")
                {
                    L.marker([lat, lng]).addTo(map);
                    map.setView([lat, lng], 16);
                }
            }

            // LINE OBSTACLES
            if (obstacle.obstacleType === "line" && obstacle.obstacleLineCoordinates) 
            {

                const coords = obstacle.obstacleGeoJson
                    ? JSON.parse(obstacle.obstacleGeoJson).geometry.coordinates
                    : [];

                if (coords.length >= 2) 
                {
                    const latlngs = coords.map(c => [c[1], c[0]]);
                    const line = L.polyline(latlngs, {
                        color: "black",
                        weight: 3
                    }).addTo(map);

                    map.fitBounds(line.getBounds());
                }
             }
         });
    </script>
}
