<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Obstacle Registration App</title>

    <!-- Tailwind CSS (built to wwwroot/css/output.css) -->
    <link href="~/css/output.css" rel="stylesheet" asp-append-version="true" />

    <!-- CSS-files -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-gray-50 flex flex-col min-h-screen">

    <header>
        <nav class="bg-white shadow-md" aria-label="Main">
            <div class="container mx-auto flex items-center justify-between px-4 py-3">
                <!-- Logo -->
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center">
                 @*    <img src="~/icons/logo.png" alt="Logo" class="h-10" /> *@
                    <span class="ml-2 text-lg font-bold text-gray-800">Obstacle Registration App</span>
                </a>

                <!-- Hamburger (mobile) -->
                <div class="sm:hidden">
                    <button id="menu-btn" class="text-gray-800 focus:outline-none" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                </div>

                <!-- Meny (desktop) -->
                <ul id="menu" class="hidden space-x-4 font-medium text-gray-800 sm:flex">
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {             
                        @if (User.IsInRole("Pilot") || User.IsInRole("Registrar"))
                        {
                            <li><a class="block hover:text-green-600" asp-area="" asp-controller="Obstacle" asp-action="DataForm" asp-route-id="">Obstacle Registration</a></li>
                        }
                        <li><a class="block hover:text-green-600" asp-area="" asp-controller="Reports" asp-action="Index">Reports</a></li>
                  @*       <li><a class="block hover:text-green-600" asp-area="" asp-controller="User" asp-action="UserProfile">User Profile</a></li> *@                                            
                        <li><a class="block hover:text-green-600" asp-area="" asp-controller="User" asp-action="UserProfile">My Profile</a></li>
                        <li><form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="inline">
                                @Html.AntiForgeryToken()
                           @*      <button type="submit" class="block w-full text-left hover:text-green-600">Sign out</button> *@
                                <button type="submit" class="button-text-left hover:text-green-600">
                                    Sign out
                                </button>


                            </form>
                        </li>
                    }
                </ul>
                </div>

@*                 <ul id="menu" class="hidden space-x-4 font-medium text-gray-800 sm:flex">
                    <li><a class="hover:text-green-600" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                    @if (!(User?.Identity?.IsAuthenticated ?? false) || User.IsInRole("Pilot") || User.IsInRole("Registrar"))
                    {
                        <li><a class="hover:text-green-600" asp-area="" asp-controller="Obstacle" asp-action="DataForm" asp-route-id="">Obstacle Registration</a></li>
                    }
                    <li><a class="hover:text-green-600" asp-area="" asp-controller="Reports" asp-action="Index">Reports</a></li>
                    <li><a class="hover:text-green-600" asp-area="" asp-controller="User" asp-action="Index">User</a></li>   
                    @if (!(User?.Identity?.IsAuthenticated ?? false))
                    {
                        <li><a class="hover:text-green-600" asp-area="" asp-controller="User" asp-action="UserForm">Register</a></li>
                        <li><a class="hover:text-green-600" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a></li>
                    }
                    else
                    {
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="hover:text-green-600">Sign out</button>
                            </form>
                        </li>
                    }
                </ul>
            </div> *@

            <!-- Mobile-meny -->
            <ul id="mobile-menu" class="hidden flex-col space-y-2 bg-white px-4 pb-4 sm:hidden">
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <li><a class="block hover:text-green-600" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                                                
                @if (User.IsInRole("Pilot") || User.IsInRole("Registrar"))
                {
                    <li><a class="block hover:text-green-600" asp-area="" asp-controller="Obstacle" asp-action="DataForm" asp-route-id="">Obstacle Registration</a></li>
                }
                <li><a class="block hover:text-green-600" asp-area="" asp-controller="Reports" asp-action="Index">Reports</a></li>
                <li><a class="block hover:text-green-600" asp-area="" asp-controller="User" asp-action="Index">User</a></li>
              
                        <li><a class="block hover:text-green-600" asp-area="" asp-controller="User" asp-action="UserForm">Register</a></li>
                        <li><a class="block hover:text-green-600" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="block w-full text-left hover:text-green-600">Sign out</button>
                            </form>
                        </li>                   
                }                                                
            </ul>


  @*           <!-- Mobile-meny -->
            <ul id="mobile-menu" class="hidden flex-col space-y-2 bg-white px-4 pb-4 sm:hidden">
                <li><a class="block hover:text-green-600" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                @if (!(User?.Identity?.IsAuthenticated ?? false) || User.IsInRole("Pilot") || User.IsInRole("Registrar"))
                {
                    <li><a class="block hover:text-green-600" asp-area="" asp-controller="Obstacle" asp-action="DataForm" asp-route-id="">Obstacle Registration</a></li>
                }
                <li><a class="block hover:text-green-600" asp-area="" asp-controller="Reports" asp-action="Index">Reports</a></li>
                <li><a class="block hover:text-green-600" asp-area="" asp-controller="User" asp-action="Index">User</a></li>          
                @if (!(User?.Identity?.IsAuthenticated ?? false))
                {
                    <li><a class="block hover:text-green-600" asp-area="" asp-controller="User" asp-action="UserForm">Register</a></li>
                    <li><a class="block hover:text-green-600" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a></li>
                }
                else
                {
                    <li>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="block w-full text-left hover:text-green-600">Sign out</button>
                        </form>
                    </li>
                }
            </ul> *@
        </nav>
    </header>

    <div class="flex-1 container mx-auto mt-6 px-4">
        <main role="main" class="pb-6">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-auto border-t bg-white py-4">
        <div class="container mx-auto px-4 text-center text-gray-600">
            &copy; 2025 - Obstacle Registration App (Group 14)           
        </div>
    </footer>

    <script>
        // Toggle mobile-meny (checking if the elements exist)
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        if (menuBtn && mobileMenu) {
            menuBtn.addEventListener('click', () => {
                const isHidden = mobileMenu.classList.toggle('hidden');
                menuBtn.setAttribute('aria-expanded', String(!isHidden));
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
